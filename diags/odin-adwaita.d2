# odin-adwaita: its place in the binding graph
# Render:  d2 diags/odin-adwaita.d2 diags/odin-adwaita.svg

direction: down

title: "odin-adwaita" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-adwaita\nlibadwaita 1.5.0" {
  style.fill: "#eef6ff"
}
lib: "libadwaita-1 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"adwaita:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection adwaita
this -> lib: foreign import
